<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.*?>
<?import java.util.*?>
<?import javafx.scene.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.layout.*?>

<AnchorPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller=".com.library.ui.LoginMenu"
            prefHeight="400.0" prefWidth="600.0">

    <children>
        <ScrollPane fitToWidth="true" fitToHeight="true"
                    AnchorPane.topAnchor="0.0"
                    AnchorPane.bottomAnchor="0.0"
                    AnchorPane.leftAnchor="0.0"
                    AnchorPane.rightAnchor="0.0">
            <content>
                <VBox alignment="CENTER" spacing="15" >
                    <padding>
                        <Insets bottom="20" left="20" right="20" top="20"/>
                    </padding>

                    <Label text="Register New Account">
                        <font>
                            <Font size="18"/>
                        </font>
                    </Label>

                    <GridPane hgap="10" vgap="10">
                        <Label text="Username:" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
                        <TextField fx:id="regUsernameField" GridPane.columnIndex="1" GridPane.rowIndex="0"/>

                        <Label text="Full Name:" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
                        <TextField fx:id="regFullNameField" GridPane.columnIndex="1" GridPane.rowIndex="1"/>

                        <Label text="Password:" GridPane.columnIndex="0" GridPane.rowIndex="2"/>
                        <PasswordField fx:id="regPasswordField" GridPane.columnIndex="1" GridPane.rowIndex="2"/>

                        <Label text="Role:" GridPane.columnIndex="0" GridPane.rowIndex="3"/>
                        <ComboBox fx:id="regRoleComboBox" prefWidth="150.0" GridPane.columnIndex="1" GridPane.rowIndex="3"/>

                        <!-- Additional fields for specific roles -->
                        <Label fx:id="bioLabel" text="Bio:" visible="false" managed="false"
                               GridPane.columnIndex="0" GridPane.rowIndex="4"/>
                        <TextArea fx:id="bioArea" visible="false" managed="false"
                                  prefRowCount="3" prefWidth="300.0"
                                  GridPane.columnIndex="1" GridPane.rowIndex="4"/>

                        <Label fx:id="employeeIdLabel" text="Employee ID:" visible="false" managed="false"
                               GridPane.columnIndex="0" GridPane.rowIndex="4"/>
                        <TextField fx:id="employeeIdField" visible="false" managed="false"
                                   GridPane.columnIndex="1" GridPane.rowIndex="4"/>
                    </GridPane>

                    <Label fx:id="passwordHintLabel"
                           text="Password must be at least 8 characters with uppercase, lowercase, and number"
                           wrapText="true" style="-fx-text-fill: gray;" maxWidth="400.0"/>

                    <HBox alignment="CENTER" spacing="10">
                        <Button text="Register" onAction="#handleRegisterSubmit" prefWidth="100.0"/>
                        <Button text="Back to Login" onAction="#handleBackToLogin" prefWidth="100.0"/>
                    </HBox>

                    <Label fx:id="regMessageLabel" textFill="red" wrapText="true"/>
                </VBox>
            </content>
        </ScrollPane>
    </children>
</AnchorPane>
